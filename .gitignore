# One ignore file for the whole repo; paths are relative to the root.

# --- Python ---
__pycache__/
*.pyc
.venv/
.pytest_cache/

# --- Django ---
portfolio-saas/backend/staticfiles/
portfolio-saas/backend/db.sqlite3
# Generated operational evidence; durable conclusions belong in docs/REFERENCE.md.
portfolio-saas/backend/recovery-manifests/

# --- Node ---
portfolio-saas/frontend/node_modules/
portfolio-saas/frontend/dist/
portfolio-saas/frontend/test-results/
portfolio-saas/frontend/playwright-report/

# --- Secrets / local env ---
.env
.env.local
.env.production
!.env.production.example

# --- Runtime scratch ---
celerybeat-schedule
celerybeat-schedule.db
backups/
portfolio-saas/import-data/
*.sql.gz
*.dump
# Redis writes dump.rdb into whatever directory it was started from, which for a
# locally-run redis-server is the repository root.
dump.rdb

# --- Generated artifacts / tooling ---
# Knowledge graph output is regenerated by `graphify update .` — never commit.
graphify-out/
# Claude Code: settings.json/skills/agents/.mcp.json are shared config, tracked.
# Only the per-user local override file is ignored.
.claude/settings.local.json

# --- OS / editors ---
.DS_Store
.idea/
.vscode/
.cursor/

# Lighthouse CI run artefacts
.lighthouseci/

# Scratch Playwright probe, not part of the suite
portfolio-saas/frontend/probe.mjs
portfolio-saas/frontend/scripts/_probe.mjs
portfolio-saas/frontend/scripts/explore.mjs
portfolio-saas/frontend/artifacts/
