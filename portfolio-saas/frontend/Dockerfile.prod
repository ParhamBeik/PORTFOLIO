# Production frontend image: build with Vite, then serve the static bundle from
# nginx with an SPA fallback. Caddy (docker-compose.prod.yml) sits in front for
# TLS and reverse-proxies / here, /api/* to the backend.

# --- build stage ---
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci || npm install
COPY . .
RUN npm run build

# --- serve stage ---
FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
