# Development environment. Copy to `.env` (gitignored) and fill in the two API
# keys; everything else here works as written for `docker compose up`.
#
# The DEV counterpart to .env.production.example. Only the variables you
# normally need are listed -- config/settings.py reads about 130 in total and
# every one not named here has a working default. Go to the settings module
# when you need to tune archive pacing, quota shares, throttles or the
# direct-source breakers.

# --- Django ---
DJANGO_SECRET_KEY=any-long-random-string-for-local-use-only
DJANGO_DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173

# --- Database (matches the `db` service in docker-compose.yml) ---
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio

# --- Providers ---
# Both come from the BrsApi panel. They are separate products with separate
# daily budgets: BRS_API_KEY covers Market/* (gold, currency, crypto) and
# TSETMC_API_KEY covers Tsetmc/* and Codal/*. Without them the app boots and
# serves, but no price ever lands.
BRS_API_KEY=your-brsapi-market-key
TSETMC_API_KEY=your-brsapi-tsetmc-key

# --- Frontend ---
# Left empty, the dev server proxies /api to the backend on :8000.
VITE_API_URL=

# --- Optional ---
# Codal filing ingestion, off by default in dev: it needs S3/MinIO and spends
# the TSETMC budget. The name is CODAL_ENABLED -- it gates the queue route, the
# beat entry and archive.disabled_endpoints() together. CODAL_EXTRACTION_ENABLED
# is NOT a setting this codebase reads; if you have it in a .env somewhere, it
# has never done anything.
CODAL_ENABLED=0
# Error reporting. Empty disables it.
SENTRY_DSN=
