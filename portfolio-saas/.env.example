# Copy to .env and adjust. The BRS/TSETMC keys come from the original project.
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
ALLOWED_HOSTS=backend,localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173

# Market data source keys (Iranian markets: BRS gold/currency, TSETMC stocks).
# Get your own key from BrsApi.ir — never commit a real key here.
BRS_API_KEY=your_brs_api_key_here
TSETMC_API_KEY=your_brs_api_key_here

# For the GitHub Actions fetcher: a libpq connection string to the prod DB.
# DATABASE_URL=postgres://portfolio:portfolio@HOST:5432/portfolio

# Stripe billing (Dashboard > Developers > API keys / Endpoint signing secret).
# Leave blank to run without billing; the webhook is signature-verified when set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_SUCCESS_URL=http://localhost:5173/billing?status=success
STRIPE_CANCEL_URL=http://localhost:5173/billing?status=cancel

# Frontend (leave VITE_API_URL blank in dev; vite proxies /api to the backend)
VITE_API_URL=
