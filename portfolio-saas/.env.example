# Copy to .env and adjust. BRS/TSETMC keys come from BrsApi.ir; Zarinpal
# merchant id from your Zarinpal merchant dashboard.
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
ALLOWED_HOSTS=backend,localhost,127.0.0.1
CORS_ORIGINS=http://localhost:5173

# Market data source keys (Iranian markets: BRS gold/currency, TSETMC stocks).
# Get your own key from BrsApi.ir — never commit a real key here.
BRS_API_KEY=your_brs_api_key_here
TSETMC_API_KEY=your_brs_api_key_here

# For the GitHub Actions fetcher: a libpq connection string to the prod DB.
# DATABASE_URL=postgres://portfolio:portfolio@HOST:5432/portfolio

# Zarinpal billing (Iranian payment gateway — Stripe is not used; Iranian cards
# cannot pay USD). Get MERCHANT_ID from your Zarinpal merchant dashboard. Pro is
# annual-prepay; set the price in TOMAN (ZARINPAL multiplies by 10 to Rial).
# CALLBACK_URL is the backend endpoint Zarinpal redirects to after payment;
# FRONTEND_URL is where we then send the browser (the billing page).
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_CALLBACK_URL=http://localhost:5173/api/billing/zarinpal/callback/
ZARINPAL_FRONTEND_URL=http://localhost:5173/billing
ZARINPAL_SANDBOX=1
PRO_PRICE_TOMAN=1000000

# Frontend (leave VITE_API_URL blank in dev; vite proxies /api to the backend)
VITE_API_URL=
