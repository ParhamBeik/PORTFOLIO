# Copy to .env.production and fill in real values before:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# The compose file marks the critical ones with :? so it refuses to boot if any
# is missing. Keep this file out of version control (it's already gitignored).

# --- Site ---
# Canonical hostname Caddy serves and gets a cert for (no scheme, no path).
DOMAIN=app.example.com
# Comma-separated; must include DOMAIN and any alias. No localhost in prod
# (settings.py refuses to boot with DEBUG=0 + a localhost CORS origin).
ALLOWED_HOSTS=app.example.com
# Exact https origin(s) the browser talks to.
CORS_ORIGINS=https://app.example.com

# --- Django ---
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0

# --- Postgres ---
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=

# --- Market data (BRS/TSETMC) ---
BRS_API_KEY=
TSETMC_API_KEY=

# --- Zarinpal billing ---
# Live Zarinpal merchant UUID from the dashboard. Keep SANDBOX=0 for production.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=0
# Must be reachable from the user's browser, over HTTPS (Zarinpal POSTs back here).
ZARINPAL_CALLBACK_URL=https://app.example.com/api/billing/zarinpal/callback/
# Where the callback redirects the browser after pay/cancel.
ZARINPAL_FRONTEND_URL=https://app.example.com/billing
# Annual Pro price in Toman (Rial sent to the gateway = this x10).
PRO_PRICE_TOMAN=1000000

# --- Let's Encrypt (optional; Caddy works without it) ---
# Set to receive cert-expiry notices from Let's Encrypt.
# LE_EMAIL=you@example.com
