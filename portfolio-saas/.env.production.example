PORTFOLIO_DOMAIN=portfolio.example.com
ALLOWED_HOSTS=portfolio.example.com
CORS_ORIGINS=https://portfolio.example.com
DJANGO_SECRET_KEY=generate-at-least-50-random-characters
REGISTRATION_OPEN=1

POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=generate-a-random-database-password

BRS_API_KEY=replace-after-rotating-the-exposed-key
BRSAPI_ACCOUNT_PHONE=
# Enable only after the BrsApi panel reader is verified from this host.
MARKETDATA_PANEL_METER_ENABLED=0
TSETMC_API_KEY=replace-after-rotating-the-exposed-key
BRS_URL=https://Api.BrsApi.ir/Market/Gold_Currency.php
TSETMC_URL=https://Api.BrsApi.ir/Tsetmc/AllSymbols.php
# Set to 0 during a queue-copy cutover to preserve queued work without
# waking a paused paid archive worker or an unvalidated Codal worker.
ARCHIVE_WORKER_ENABLED=1
CODAL_WORKER_ENABLED=1
# One-time legacy Redis cutover: copy requires both paid workers disabled.
BROKER_HANDOFF_MODE=drain

EMAIL_HOST=replace-with-smtp-host
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=noreply@portfolio.example.com
FRONTEND_VERIFICATION_URL=https://portfolio.example.com/verify-email
FRONTEND_PASSWORD_RESET_URL=https://portfolio.example.com/reset-password

SENTRY_DSN=
VITE_SENTRY_DSN=
ALERT_WEBHOOK_URL=
# Operator alerts via a Bale bot (Telegram-compatible API; Telegram is blocked
# from the VPS). Both token and chat id are needed for the channel to send.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_TELEGRAM_API_BASE=https://tapi.bale.ai

# Generate from the News project's GapGPT settings with deploy/sync_gapgpt_config.py.
# The backend sees only this projected secret; the browser never receives the key.
GAPGPT_CONFIG_HOST_FILE=/opt/apps/portfolio-secrets/gapgpt.env
# A user selects a lower cap for each research run in the application.
RESEARCH_MAX_RUN_USD=0.10
RESEARCH_DAILY_BUDGET_USD=1.00

# News Intelligence price contract (/api/marketdata/news/*). Same random value
# as PORTFOLIO_MARKET_SERVICE_KEY in the news app's .env. Empty disables it (403).
NEWS_MARKET_SERVICE_KEY=
